class Result {

    /*
     * Complete the 'maxSubarray' function.
     *
     * The function is expected to return an INTEGER_ARRAY.
     * The function accepts INTEGER_ARRAY arr as parameter.
     */

    public static List<Integer> maxSubarray(List<Integer> arr) {
        List<Integer> result = new ArrayList<Integer>();
        
        // 1. Calculate Maximum Subarray Sum (Kadane's Algorithm)
        // Since the array must have at least one element, we initialize with the first element.
        int maxSoFar = arr.get(0);
        int currentMax = arr.get(0);
        
        for (int i = 1; i < arr.size(); i++) {
            int num = arr.get(i);
            // Either extend the current subarray or start a new one from current element
            currentMax = Math.max(num, currentMax + num);
            maxSoFar = Math.max(maxSoFar, currentMax);
        }
        
        // 2. Calculate Maximum Subsequence Sum
        // If there are positive numbers, sum them all.
        // If all numbers are negative, the max subsequence is the single largest element.
        int maxSubseq = Integer.MIN_VALUE;
        int sumPositives = 0;
        boolean hasPositive = false;
        
        for (int num : arr) {
            if (num > 0) {
                sumPositives += num;
                hasPositive = true;
            }
            if (num > maxSubseq) {
                maxSubseq = num;
            }
        }
        
        // If we found positive numbers, the max subsequence is their sum.
        // Otherwise, it's the maximum single element (which will be negative).
        if (hasPositive) {
            maxSubseq = sumPositives;
        }
        
        result.add(maxSoFar);
        result.add(maxSubseq);
        
        return result;
    }

}

public class Solution {
    public static void main(String[] args) throws IOException {
        BufferedReader bufferedReader = new BufferedReader(new InputStreamReader(System.in));
        // BufferedWriter bufferedWriter = new BufferedWriter(new FileWriter(System.getenv("OUTPUT_PATH"))); // Uncomment for file output
        // BufferedWriter bufferedWriter = new BufferedWriter(new OutputStreamWriter(System.out)); // For stdout

        int t = Integer.parseInt(bufferedReader.readLine().trim());

        while (t-- > 0) {
            int n = Integer.parseInt(bufferedReader.readLine().trim());
            String[] arrTemp = bufferedReader.readLine().replaceAll("\\s+$", "").split(" ");
            List<Integer> arr = new ArrayList<Integer>();

            for (int i = 0; i < n; i++) {
                arr.add(Integer.parseInt(arrTemp[i]));
            }

            List<Integer> res = Result.maxSubarray(arr);
            
            // Print result for this test case
            System.out.println(res.get(0) + " " + res.get(1));
        }

        bufferedReader.close();
    }
}
