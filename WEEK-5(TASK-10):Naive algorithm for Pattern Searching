import java.util.ArrayList;
import java.util.List;

public class NaivePatternSearch {

    // Function to search for all occurrences of 'pat' in 'txt' using Naive Approach
    public static List<Integer> search(String pat, String txt) {
        int n = txt.length();
        int m = pat.length();
        List<Integer> matches = new ArrayList<>();

        // Slide the pattern over text one by one
        for (int i = 0; i <= n - m; i++) {
            int j;

            // Check for pattern match at index i
            for (j = 0; j < m; j++) {
                if (txt.charAt(i + j) != pat.charAt(j)) {
                    break; // Mismatch found, stop checking this position
                }
            }

            // If pattern matches, store index
            if (j == m) {
                matches.add(i);
            }
        }

        return matches;
    }

    public static void main(String[] args) {
        String txt = "aabaacaadaabaaba";
        String pat = "aaba";

        List<Integer> result = search(pat, txt);

        System.out.println("Pattern found at indices: " + result);
        for (int index : result) {
            System.out.print(index + " ");
        }
    }
}
