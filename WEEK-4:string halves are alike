public class Solution {
    public boolean halvesAreAlike(String s) {
        int n = s.length();
        int mid = n / 2;
        
        int countFirstHalf = 0;
        int countSecondHalf = 0;
        
        // Loop untuk menghitung vokal di kedua bagian sekaligus
        for (int i = 0; i < mid; i++) {
            char first = s.charAt(i);
            char second = s.charAt(mid + i);
            
            if (isVowel(first)) {
                countFirstHalf++;
            }
            if (isVowel(second)) {
                countSecondHalf++;
            }
        }
        
        return countFirstHalf == countSecondHalf;
    }
    
    // Helper method untuk mengecek apakah karakter adalah vokal
    private boolean isVowel(char c) {
        // Mengubah ke huruf kecil untuk penyederhanaan pengecekan
        c = Character.toLowerCase(c);
        return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
    }
}
