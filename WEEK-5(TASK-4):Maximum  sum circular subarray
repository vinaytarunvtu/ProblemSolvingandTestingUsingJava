class Solution {
    public int maxSubarraySumCircular(int[] nums) {
        int n = nums.length;
        
        // Compute linear max subarray sum using Kadane's
        int maxLinear = kadaneMax(nums);
        
        // If all numbers are negative, maxLinear is the answer
        if (maxLinear < 0) {
            return maxLinear;
        }
        
        // Compute total sum and min subarray sum
        int totalSum = 0;
        int minLinear = kadaneMin(nums);
        
        for (int num : nums) {
            totalSum += num;
        }
        
        // Max circular sum = totalSum - minLinear
        int maxCircular = totalSum - minLinear;
        
        // Return the maximum of linear and circular cases
        return Math.max(maxLinear, maxCircular);
    }
    
    // Standard Kadane's for maximum subarray sum
    private int kadaneMax(int[] nums) {
        int maxSoFar = nums[0];
        int currentMax = nums[0];
        
        for (int i = 1; i < nums.length; i++) {
            currentMax = Math.max(nums[i], currentMax + nums[i]);
            maxSoFar = Math.max(maxSoFar, currentMax);
        }
        
        return maxSoFar;
    }
    
    // Kadane's for minimum subarray sum
    private int kadaneMin(int[] nums) {
        int minSoFar = nums[0];
        int currentMin = nums[0];
        
        for (int i = 1; i < nums.length; i++) {
            currentMin = Math.min(nums[i], currentMin + nums[i]);
            minSoFar = Math.min(minSoFar, currentMin);
        }
        
        return minSoFar;
    }
}
