import java.util.HashSet;
import java.util.Set;

class Solution {
    public boolean containsDuplicate(int[] nums) {
        // Use a HashSet to track numbers we've seen so far
        Set<Integer> seen = new HashSet<>();
        
        for (int num : nums) {
            // If the set already contains this number, we found a duplicate
            if (!seen.add(num)) {
                return true;
            }
        }
        
        // If we finish the loop without finding duplicates, return false
        return false;
    }
}
