class Result {
    /*
     * Complete the 'birthday' function below.
     *
     * The function is expected to return an INTEGER.
     * The function accepts following parameters:
     *  1. INTEGER_ARRAY s
     *  2. INTEGER d
     *  3. INTEGER m
     */
    public static int birthday(List<Integer> s, int d, int m) {
        // Write your code here
        int count = 0;
        int n = s.size();
        
        // If the array is smaller than the required segment length, no solution possible
        if (n < m) {
            return 0;
        }
        
        // Check each possible starting position for a segment of length m
        for (int i = 0; i <= n - m; i++) {
            int sum = 0;
            // Calculate sum of the current segment
            for (int j = 0; j < m; j++) {
                sum += s.get(i + j);
            }
            // If sum matches Ron's birth day, increment counter
            if (sum == d) {
                count++;
            }
        }
        
        return count;
    }
}

